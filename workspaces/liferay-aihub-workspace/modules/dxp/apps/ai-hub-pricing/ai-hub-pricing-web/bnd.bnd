Bundle-Name: Liferay AI Hub Pricing Web
Bundle-SymbolicName: com.liferay.ai.hub.pricing.web
Bundle-Version: 1.0.0
Provide-Capability:\
	osgi.webresource;\
		osgi.webresource="@liferay/ai-hub-pricing-web";\
		version:Version="1.0.0"
Web-ContextPath: /ai-hub-pricing-web
-dsannotations-options: inherit
-includeresource:\
	META-INF/resources=build/node/packageRunBuild/resources/META-INF/resources,\
	package.json