#
# Exclude everything
#

/*
*.iml

#
# Include top level files
#

!/.gitignore
!/build-working-dir.xml
!/working.dir.properties

#
# Include modules/dxp/apps/ai-hub-pricing
#

!/modules
/modules/*
!/modules/dxp
/modules/dxp/*
!/modules/dxp/apps
/modules/dxp/apps/*
!/modules/dxp/apps/ai-hub-pricing
/modules/dxp/apps/ai-hub-pricing/*/build

#
# Include workspaces/liferay-aihub-workspace
#

!/workspaces
/workspaces/*
!/workspaces/liferay-aihub-workspace
/workspaces/liferay-aihub-workspace/.gradle