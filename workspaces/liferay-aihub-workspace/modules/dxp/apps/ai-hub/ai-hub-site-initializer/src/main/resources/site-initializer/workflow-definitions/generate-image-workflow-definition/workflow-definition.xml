<?xml version="1.0"?>

<workflow-definition
	xmlns="urn:liferay.com:liferay-workflow_7.4.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="urn:liferay.com:liferay-workflow_7.4.0 http://www.liferay.com/dtd/liferay-workflow-definition_7_4_0.xsd"
>
	<name>Generate Image</name>
	<version>1</version>
	<service>
		<name>requestImageStyle</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						276,
						130
					]
				}
			]]>
		</metadata>
		<java-delegate>javaDelegate#requestImageStyle</java-delegate>
		<labels>
			<label language-id="en_US">
				Request Image Style
			</label>
		</labels>
		<output-variables>
			<![CDATA[
				[
					{
						"name": "style",
						"type": "string"
					}
				]
			]]>
		</output-variables>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						Generate Image
					</label>
				</labels>
				<name>generateImage</name>
				<target>generateImage</target>
				<default>true</default>
			</transition>
		</transitions>
	</service>
	<llm>
		<name>generateImage</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						276,
						242
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				Generate Image
			</label>
		</labels>
		<input-variables>
			<![CDATA[
				[
					{
						"name": "description",
						"type": "string"
					},
					{
						"name": "style",
						"type": "string"
					}
				]
			]]>
		</input-variables>
		<output-variables>
			<![CDATA[
				[
					{
						"name": "output",
						"type": "string"
					}
				]
			]]>
		</output-variables>
		<prompt>
			<![CDATA[You are an image generation assistant. Generate images by calling the image generation tool. When you call the tool, compose the prompt as follows: "Generate exactly N separate images. Each image must be its own standalone image output, not a collage and not a grid. Produce the images one after another. Description of the images: <the user's complete request>. Artistic style: <the artistic style given in the user message>", replacing N with the number of images the user requested and defaulting to 1 when no quantity is given. Never ask the user which artistic style to use; the style is always chosen before you are called and is given in the user message.]]>
		</prompt>
		<tools>
			<![CDATA[
				[
					{
						"externalReferenceCode": "L_IMAGE_GENERATION",
						"type": "tool"
					}
				]
			]]>
		</tools>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						End
					</label>
				</labels>
				<name>end</name>
				<target>end</target>
				<default>true</default>
			</transition>
		</transitions>
		<user-message>
			<![CDATA[{{description}}

Apply this artistic style: {{style}}]]>
		</user-message>
	</llm>
	<state>
		<name>start</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						273,
						25
					]
				}
			]]>
		</metadata>
		<initial>true</initial>
		<labels>
			<label language-id="en_US">
				Start
			</label>
		</labels>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						Request Image Style
					</label>
				</labels>
				<name>requestImageStyle</name>
				<target>requestImageStyle</target>
				<default>true</default>
			</transition>
		</transitions>
	</state>
	<state>
		<name>end</name>
		<metadata>
			<![CDATA[
				{
					"terminal": true,
					"xy": [
						277,
						459
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				End
			</label>
		</labels>
	</state>
</workflow-definition>